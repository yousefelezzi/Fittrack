
# Email (password and email changes). Without SMTP_HOST, emails are printed
# to the server log instead of sent. Gmail: smtp.gmail.com, port 465, your
# address as SMTP_USER and an App Password (Google account → Security) as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FitTrack <your-address@gmail.com>"
